    },
    "QualityGate": { //Eval2 - For QulaityGate Agent to evaluate groundedness of the verdict
      "Enabled": true,
      "MinGroundednessScore": 3
    },
    //Teams HITL notifications (POC: M365 Developer Program tenant).
    //When Enabled=true, the agent sends an Adaptive Card to the reviewer's Teams DM
